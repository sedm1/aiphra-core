GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/google-oauth.php
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar

# Paste the value displayed by google-oauth.php here after authorization.
GOOGLE_REFRESH_TOKEN=

# CalDAV endpoint or principal URL; the account-specific form is /caldav/v2/CALENDAR_ID/user.
GOOGLE_CALDAV_URL=https://apidata.googleusercontent.com/caldav/v2/
